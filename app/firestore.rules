rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function emailVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    // Phone confirmed by SMS: Firebase Auth puts it in the ID token and
    // attaches a number to a single account.
    function confirmedPhone() {
      return signedIn() ? request.auth.token.get('phone_number', null) : null;
    }
    // Activated account (UC01): e-mail link clicked. The SMS step is off in
    // the app for now (REQUIRE_PHONE); once it is on, also require
    // `confirmedPhone() != null` here.
    function verified() { return emailVerified(); }
    function isVerifiedOwner(uid) { return isOwner(uid) && verified(); }

    function vehiclePath(uid) {
      return /databases/$(database)/documents/vehicles/$(uid);
    }
    // getAfter sees a vehicle written in the same batch (activation).
    function vehicleReady(uid) {
      return existsAfter(vehiclePath(uid))
        && getAfter(vehiclePath(uid)).data.brand.size() >= 2
        && getAfter(vehiclePath(uid)).data.plate.size() >= 4
        && getAfter(vehiclePath(uid)).data.seats >= 1;
    }
    function photoOk() {
      return request.resource.data.photoUrl == null
        || (request.resource.data.photoUrl is string
            && request.resource.data.photoUrl.size() < 700000
            && request.resource.data.photoUrl.matches('^data:image/jpeg;base64,'));
    }

    // Public profile: readable by verified users. Driver mode can be turned
    // on only when a valid vehicle exists, and never at account creation.
    // Creation is allowed before verification because the documents are
    // written right after sign-up, before the link can be clicked.
    match /users/{uid} {
      allow read: if verified() || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.driverEnabled == false
        && request.resource.data.keys().hasOnly([
             'firstName', 'lastName', 'photoUrl', 'driverEnabled',
             'ratingAverage', 'ratingCount', 'createdAt'
           ]);
      allow update: if isVerifiedOwner(uid) && (
        (request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['firstName', 'lastName', 'photoUrl'])
          && photoOk()
          && request.resource.data.firstName.size() >= 2
          && request.resource.data.lastName.size() >= 2)
        || (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['driverEnabled'])
            && request.resource.data.driverEnabled == false)
        || (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['driverEnabled'])
            && request.resource.data.driverEnabled == true
            && vehicleReady(uid))
      );
      allow delete: if false;
    }

    // Vehicle: owner and admins only, so the plate never reaches the feed.
    match /vehicles/{uid} {
      allow read: if isVerifiedOwner(uid) || isAdmin();
      allow create, update: if isVerifiedOwner(uid)
        && request.resource.data.keys().hasOnly([
             'brand', 'plate', 'seats', 'updatedAt'
           ])
        && request.resource.data.brand is string
        && request.resource.data.brand.size() >= 2
        && request.resource.data.brand.size() <= 40
        && request.resource.data.plate is string
        && request.resource.data.plate.matches('^[0-9A-Z -]{4,15}$')
        && request.resource.data.seats is int
        && request.resource.data.seats >= 1
        && request.resource.data.seats <= 8;
      allow delete: if false;
    }

    // Private contact data: owner and admins only. The phone typed at
    // sign-up is unconfirmed; it can only be replaced by the number
    // confirmed by SMS.
    match /users_private/{uid} {
      allow read: if (isOwner(uid) && emailVerified()) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'phone', 'createdAt'])
        && request.resource.data.phone.matches('^[+]216[2-9][0-9]{7}$');
      allow update: if isOwner(uid) && emailVerified()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['phone'])
        && request.resource.data.phone == confirmedPhone();
      allow delete: if false;
    }

    function knownPlace(id) {
      return id in [
        'tunis', 'ariana', 'ben_arous', 'manouba', 'marsa', 'nabeul',
        'hammamet', 'bizerte', 'sousse', 'monastir', 'sfax'
      ];
    }
    function driverOn() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.driverEnabled == true;
    }
    function tripDataOk(data) {
      return data.driverName is string
        && data.driverName.size() >= 2
        && data.driverName.size() <= 80
        && data.vehicleBrand is string
        && data.vehicleBrand.size() >= 2
        && data.vehicleBrand.size() <= 40
        && knownPlace(data.departureId)
        && knownPlace(data.destinationId)
        && data.departureId != data.destinationId
        && data.departureAt > request.time
        && data.seatsTotal is int
        && data.seatsTotal >= 1
        && data.seatsTotal <= 8
        && data.seatsAvailable == data.seatsTotal
        && data.acceptedCount == 0
        && data.seatsTotal <= get(vehiclePath(request.auth.uid)).data.seats
        && data.vehicleBrand == get(vehiclePath(request.auth.uid)).data.brand
        && (data.pricePerSeat == null
            || (data.pricePerSeat is number
                && data.pricePerSeat >= 0
                && data.pricePerSeat <= 500))
        && (data.description == null
            || (data.description is string && data.description.size() <= 300))
        && data.luggage is bool
        && data.roundTrip is bool;
    }

    // Trips. The plate is not a field, so it cannot leak into the feed.
    // A planned trip is cancelled, never deleted.
    match /trips/{tripId} {
      allow read: if verified() && (
        resource.data.status != 'cancelled'
        || isOwner(resource.data.driverId)
        || isAdmin()
      );
      allow create: if verified()
        && driverOn()
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.status == 'planned'
        && request.resource.data.keys().hasOnly([
             'driverId', 'driverName', 'vehicleBrand', 'departureId',
             'destinationId', 'departureAt', 'seatsTotal', 'seatsAvailable',
             'pricePerSeat', 'description', 'luggage', 'roundTrip',
             'status', 'acceptedCount', 'createdAt'
           ])
        && tripDataOk(request.resource.data);
      allow update: if isVerifiedOwner(resource.data.driverId)
        && request.resource.data.driverId == resource.data.driverId
        && request.resource.data.vehicleBrand == resource.data.vehicleBrand
        && request.resource.data.driverName == resource.data.driverName
        && (
          (resource.data.status == 'planned'
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status']))
          || (resource.data.status == 'planned'
            && request.resource.data.status == 'ongoing'
            && driverOn()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status']))
          || (resource.data.status == 'ongoing'
            && request.resource.data.status == 'completed'
            && driverOn()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status']))
          || (resource.data.status == 'planned'
            && request.resource.data.status == 'planned'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['seatsAvailable', 'acceptedCount'])
            && request.resource.data.seatsAvailable >= 0
            && request.resource.data.seatsAvailable <= request.resource.data.seatsTotal
            && request.resource.data.acceptedCount >= 0)
          || (resource.data.status == 'planned'
            && resource.data.seatsAvailable == resource.data.seatsTotal
            && request.resource.data.status == 'planned'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly([
                   'departureId', 'destinationId', 'departureAt',
                   'seatsTotal', 'seatsAvailable', 'pricePerSeat',
                   'description', 'luggage', 'roundTrip'
                 ])
            && tripDataOk(request.resource.data))
        );
      // The passenger gives the seats back while cancelling an accepted booking.
      allow update: if verified()
        && resource.data.status == 'planned'
        && request.resource.data.status == 'planned'
        && request.resource.data.driverId == resource.data.driverId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['seatsAvailable', 'acceptedCount'])
        && get(/databases/$(database)/documents/trips/$(tripId)/reservations/$(request.auth.uid)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/trips/$(tripId)/reservations/$(request.auth.uid)).data.status == 'cancelled'
        && request.resource.data.seatsAvailable == resource.data.seatsAvailable
             + get(/databases/$(database)/documents/trips/$(tripId)/reservations/$(request.auth.uid)).data.seats
        && request.resource.data.acceptedCount == resource.data.get('acceptedCount', 0) - 1;
      allow delete: if false;

      // One request per passenger. Pending does not take a seat; accepting does.
      match /reservations/{passengerId} {
        function trip() {
          return get(/databases/$(database)/documents/trips/$(tripId)).data;
        }
        function tripAfter() {
          return getAfter(/databases/$(database)/documents/trips/$(tripId)).data;
        }
        function isDriver() {
          return isOwner(trip().driverId);
        }

        allow read: if verified() && (
          isOwner(passengerId) || isDriver() || isAdmin()
        );
        allow create: if verified()
          && isOwner(passengerId)
          && passengerId != trip().driverId
          && trip().status == 'planned'
          && request.resource.data.keys().hasOnly([
               'tripId', 'passengerId', 'passengerName', 'seats', 'status', 'createdAt'
             ])
          && request.resource.data.tripId == tripId
          && request.resource.data.passengerId == passengerId
          && request.resource.data.status == 'pending'
          && request.resource.data.seats is int
          && request.resource.data.seats >= 1
          && request.resource.data.seats <= trip().seatsAvailable
          && request.resource.data.passengerName is string
          && request.resource.data.passengerName.size() >= 2
          && request.resource.data.passengerName.size() <= 80;
        allow update: if verified()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && (
            (isOwner(passengerId)
              && resource.data.status == 'pending'
              && request.resource.data.status == 'cancelled'
              && tripAfter().seatsAvailable == trip().seatsAvailable)
            || (isOwner(passengerId)
              && resource.data.status == 'accepted'
              && request.resource.data.status == 'cancelled'
              && trip().status == 'planned'
              && tripAfter().seatsAvailable == trip().seatsAvailable + resource.data.seats
              && tripAfter().acceptedCount == trip().get('acceptedCount', 0) - 1)
            || (isDriver()
              && driverOn()
              && resource.data.status == 'pending'
              && request.resource.data.status == 'accepted'
              && trip().status == 'planned'
              && tripAfter().seatsAvailable == trip().seatsAvailable - resource.data.seats
              && tripAfter().acceptedCount == trip().get('acceptedCount', 0) + 1)
            || (isDriver()
              && resource.data.status == 'pending'
              && request.resource.data.status == 'refused'
              && tripAfter().seatsAvailable == trip().seatsAvailable)
            || (isDriver()
              && request.resource.data.status == 'cancelled'
              && (resource.data.status == 'pending' || resource.data.status == 'accepted')
              && tripAfter().status == 'cancelled')
          );
        allow delete: if false;
      }
    }
  }
}
