rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    // Only addresses whose activation link was clicked (UC01).
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    function isVerifiedOwner(uid) { return isOwner(uid) && verified(); }

    // Public profile: readable by verified users. Users cannot grant
    // themselves the driver capability here; UC12 will go through a Cloud
    // Function that checks the vehicle.
    // Creation is allowed before verification because the documents are
    // written right after sign-up, before the link can be clicked.
    match /users/{uid} {
      allow read: if verified() || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.driverEnabled == false
        && request.resource.data.keys().hasOnly([
             'firstName', 'lastName', 'photoUrl', 'driverEnabled',
             'ratingAverage', 'ratingCount', 'createdAt'
           ]);
      allow update: if isVerifiedOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['firstName', 'lastName', 'photoUrl']);
      allow delete: if false;
    }

    // Private contact data: owner and admins only.
    match /users_private/{uid} {
      allow read: if isVerifiedOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'phone', 'createdAt']);
      allow update: if isVerifiedOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['phone']);
      allow delete: if false;
    }
  }
}
